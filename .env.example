# Имена переменных. Значения класть в .env локально или в Cursor Dashboard Secrets.
# Не коммитить заполненный .env.

TELEGRAM_BOT_TOKEN=
NEWS_CHANNEL_ID=
ADS_CHANNEL=
PUBLISH_ALLOW=no
PUBLISH_BACKEND=bot

# Нужны для чтения закрытого рекламного канала и для custom emoji от Premium-аккаунта.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_STRING_SESSION=
TELEGRAM_PHONE=

# Текст новости и комментарий. Если ключ пустой или API недоступен, текст пишет модель Cursor.
GEMINI_API_KEY=
GEMINI_MODEL=

# Карточка новости: Flux 3 Klein Edit на Kie.ai. Если ключ пустой, макет собирает Pillow.
KIE_API_KEY=
KIE_MODEL=nano-banana-2-1
